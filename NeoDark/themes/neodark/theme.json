{
    "name": "NeoDark",
    "description": "Modern dark theme",
    "credits": "joueur883",
    "version": "1.0",
    "disableMCreatorOverrides": true,
    "flatLafOverrides": {
      "Button.arc": "11",
      "Component.arc": "11",
      "CheckBox.arc": "5",
      "Spinner.arc": "11",
      "ProgressBar.arc": "11",
      "MenuItem.arc": "11",
      "TextField.arc": "11",
      "TextComponent.arc": "11",
      "ComboBox.arc": "11",
      "Panel.arc": "11",
      "ComboBox.selectionArc": "11",
      "MenuItem.selectionArc": "11",

      "Component.focusWidth": "0",
      "Component.innerFocusWidth": "0",

      "Table.showHorizontalLines": "true",
      "Table.showVerticalLines": "true",

      "TabbedPane.contentOpaque": "false",
      "Tree.renderFillBackground": "false",

      "TabbedPane.focusColor": "@background",

      "List.focusCellHighlightBorder": "0,0,0,0",
      "List.border": "0,0,0,0",
      "ScrollPane.border": "0,0,0,0",
      "Tree.border": "0,0,0,0",
      "SplitPane.border": "0,0,0,0"
    },
    "colorScheme": {
      "backgroundColor": "0x151515",
      "altBackgroundColor": "0x505050",
      "secondAltBackgroundColor": "0x151515",
      "foregroundColor": "0xf2f2f2",
      "altForegroundColor": "0xf2f2f2"
    }
}
